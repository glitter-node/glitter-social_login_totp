{
    "version": "1.0.0",
    "routes": [
        {
            "path": "*/admin/plugins/glitter-social_login_totp/totp-recovery",
            "layout": "totp_recovery",
            "auth_required": true,
            "meta": {
                "title": "$t:glitter-social_login_totp.admin.recovery.title",
                "permission": "core.users.read"
            }
        },
        {
            "path": "*/admin/plugins/glitter-social_login_totp/totp-transition",
            "layout": "totp_transition",
            "auth_required": true,
            "meta": {
                "title": "$t:glitter-social_login_totp.admin.transition.title",
                "permission": "glitter-social_login_totp.totp_transition.manage"
            }
        }
    ]
}
